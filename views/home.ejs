<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero-section position-relative overflow-hidden">
  <div class="hero-bg"></div>
  <div class="container position-relative py-5">
    <div class="row align-items-center min-vh-50">
      <div class="col-lg-7 text-white py-5">
        <span class="badge bg-warning text-dark px-3 py-2 mb-3 rounded-pill">
          <i class="bi bi-stars me-1"></i> Platform Pencarian Kos #1
        </span>
        <h1 class="display-4 fw-bold mb-3">
          Temukan Kos <span class="text-warning">Impianmu</span> dengan Mudah
        </h1>
        <p class="lead mb-4 text-light opacity-75">
          Cari, bandingkan, dan review kos dari sesama mahasiswa. 
          Kolaborasi untuk menemukan tempat tinggal terbaik!
        </p>

        <!-- Search Bar -->
        <form action="/kos" method="GET" class="mt-4">
          <div class="input-group input-group-lg shadow-lg rounded-pill overflow-hidden">
            <span class="input-group-text bg-white border-0 ps-4">
              <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" name="search" class="form-control border-0 py-3" 
                   placeholder="Cari nama kos, alamat, atau kota..." >
            <button class="btn btn-warning fw-semibold px-4" type="submit">
              <i class="bi bi-search me-1"></i> Cari
            </button>
          </div>
        </form>

        <!-- Quick Filter -->
        <div class="d-flex flex-wrap gap-2 mt-3">
          <a href="/kos?type=putra" class="btn btn-outline-light btn-sm rounded-pill">
            <i class="bi bi-gender-male me-1"></i>Kos Putra
          </a>
          <a href="/kos?type=putri" class="btn btn-outline-light btn-sm rounded-pill">
            <i class="bi bi-gender-female me-1"></i>Kos Putri
          </a>
          <a href="/kos?type=campur" class="btn btn-outline-light btn-sm rounded-pill">
            <i class="bi bi-people me-1"></i>Kos Campur
          </a>
        </div>
      </div>

      <div class="col-lg-5 d-none d-lg-block text-center py-5">
        <div class="hero-illustration">
          <i class="bi bi-houses display-1 text-warning opacity-75"></i>
          <div class="mt-3">
            <div class="d-inline-flex align-items-center bg-white bg-opacity-10 rounded-pill px-4 py-2">
              <div class="text-warning me-3">
                <i class="bi bi-building fs-4"></i>
              </div>
              <div class="text-start">
                <div class="text-white fw-bold"><%= stats.totalKos %>+ Kos</div>
                <small class="text-light opacity-75">Tersedia</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
          <div class="card-body py-4">
            <div class="stat-icon bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3">
              <i class="bi bi-building fs-3"></i>
            </div>
            <h2 class="fw-bold text-primary"><%= stats.totalKos %></h2>
            <p class="text-muted mb-0">Kos Terdaftar</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
          <div class="card-body py-4">
            <div class="stat-icon bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3">
              <i class="bi bi-people fs-3"></i>
            </div>
            <h2 class="fw-bold text-success"><%= stats.totalUsers %></h2>
            <p class="text-muted mb-0">Pengguna Aktif</p>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 stat-card">
          <div class="card-body py-4">
            <div class="stat-icon bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3">
              <i class="bi bi-chat-quote fs-3"></i>
            </div>
            <h2 class="fw-bold text-warning"><%= stats.totalReviews %></h2>
            <p class="text-muted mb-0">Review Ditulis</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Latest Kos Section -->
<section class="py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Kos <span class="text-primary">Terbaru</span></h2>
      <p class="text-muted">Temukan tempat tinggal yang baru ditambahkan</p>
    </div>

    <div class="row g-4">
      <% if (latestKos.length === 0) { %>
        <div class="col-12 text-center py-5">
          <i class="bi bi-house-slash display-1 text-muted"></i>
          <p class="text-muted mt-3">Belum ada kos yang terdaftar.</p>
        </div>
      <% } else { %>
        <% latestKos.forEach(kos => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100 kos-card">
              <div class="kos-card-img position-relative">
                <% if (kos.images && kos.images.length > 0 && kos.images[0] !== '') { %>
                  <img src="/uploads/kos/<%= kos.images[0] %>" class="card-img-top" alt="<%= kos.name %>" 
                       style="height: 220px; object-fit: cover;">
                <% } else { %>
                  <div class="card-img-top bg-gradient d-flex align-items-center justify-content-center" 
                       style="height: 220px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <i class="bi bi-house-fill display-3 text-white opacity-50"></i>
                  </div>
                <% } %>
                <span class="badge bg-<%= kos.type === 'putra' ? 'primary' : kos.type === 'putri' ? 'danger' : 'success' %> position-absolute top-0 end-0 m-3 rounded-pill">
                  <i class="bi bi-<%= kos.type === 'putra' ? 'gender-male' : kos.type === 'putri' ? 'gender-female' : 'people' %> me-1"></i>
                  <%= kos.type.charAt(0).toUpperCase() + kos.type.slice(1) %>
                </span>
              </div>
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="card-title fw-bold mb-0"><%= kos.name %></h5>
                </div>
                <p class="text-muted small mb-2">
                  <i class="bi bi-geo-alt me-1 text-danger"></i><%= kos.address %>, <%= kos.city %>
                </p>
                <div class="d-flex align-items-center mb-3">
                  <div class="text-warning me-2">
                    <% for(let i = 1; i <= 5; i++) { %>
                      <i class="bi bi-star<%= i <= Math.round(kos.avg_rating) ? '-fill' : '' %> small"></i>
                    <% } %>
                  </div>
                  <small class="text-muted"><%= kos.avg_rating %> (<%= kos.total_reviews %> review)</small>
                </div>
                <div class="d-flex flex-wrap gap-1 mb-3">
                  <% if (kos.facilities && kos.facilities.length > 0) { %>
                    <% kos.facilities.slice(0, 3).forEach(f => { %>
                      <span class="badge bg-light text-dark border small"><%= f %></span>
                    <% }) %>
                    <% if (kos.facilities.length > 3) { %>
                      <span class="badge bg-light text-muted border small">+<%= kos.facilities.length - 3 %></span>
                    <% } %>
                  <% } %>
                </div>
              </div>
              <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                <div>
                  <span class="fs-5 fw-bold text-primary">Rp <%= Number(kos.price_monthly).toLocaleString('id-ID') %></span>
                  <small class="text-muted">/ bulan</small>
                </div>
                <a href="/kos/<%= kos.id %>" class="btn btn-primary btn-sm rounded-pill px-3">
                  <i class="bi bi-eye me-1"></i>Detail
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

    <% if (latestKos.length > 0) { %>
      <div class="text-center mt-5">
        <a href="/kos" class="btn btn-outline-primary btn-lg rounded-pill px-5">
          <i class="bi bi-grid me-2"></i>Lihat Semua Kos
        </a>
      </div>
    <% } %>
  </div>
</section>

<!-- How It Works -->
<section class="py-5 bg-light">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold">Cara <span class="text-primary">Kerja</span></h2>
      <p class="text-muted">Mudah dan cepat menemukan kos impianmu</p>
    </div>
    <div class="row g-4">
      <div class="col-md-4 text-center">
        <div class="step-icon bg-primary bg-opacity-10 rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
          <i class="bi bi-search fs-2 text-primary"></i>
        </div>
        <h5 class="fw-bold">1. Cari</h5>
        <p class="text-muted">Gunakan filter untuk menemukan kos sesuai kebutuhan dan budgetmu.</p>
      </div>
      <div class="col-md-4 text-center">
        <div class="step-icon bg-warning bg-opacity-10 rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
          <i class="bi bi-chat-quote fs-2 text-warning"></i>
        </div>
        <h5 class="fw-bold">2. Baca Review</h5>
        <p class="text-muted">Lihat review dan rating dari mahasiswa lain yang sudah tinggal di kos tersebut.</p>
      </div>
      <div class="col-md-4 text-center">
        <div class="step-icon bg-success bg-opacity-10 rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
          <i class="bi bi-telephone fs-2 text-success"></i>
        </div>
        <h5 class="fw-bold">3. Hubungi</h5>
        <p class="text-muted">Langsung hubungi pemilik kos untuk survey atau booking kamar.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-5">
  <div class="container">
    <div class="card border-0 shadow-lg overflow-hidden" style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);">
      <div class="card-body p-5 text-center text-white">
        <h3 class="fw-bold mb-3">Punya Kos? Daftarkan Sekarang!</h3>
        <p class="mb-4 opacity-75">Jangkau lebih banyak mahasiswa dan isi kamar kosmu dengan cepat.</p>
        <a href="/register" class="btn btn-warning btn-lg rounded-pill px-5 fw-semibold">
          <i class="bi bi-plus-circle me-2"></i>Daftarkan Kos Saya
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
