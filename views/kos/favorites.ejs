<%- include('../partials/header') %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold"><i class="bi bi-heart-fill me-2 text-danger"></i>Kos Favorit Saya</h2>
      <p class="text-muted mb-0"><%= kosList.length %> kos difavoritkan</p>
    </div>
    <a href="/kos" class="btn btn-outline-primary rounded-pill">
      <i class="bi bi-search me-1"></i>Cari Kos Lagi
    </a>
  </div>

  <% if (kosList.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-heart display-1 text-muted"></i>
      <h4 class="mt-3 text-muted">Belum ada kos favorit</h4>
      <p class="text-muted">Cari kos dan klik <i class="bi bi-heart"></i> untuk menyimpannya!</p>
      <a href="/kos" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-search me-1"></i>Cari Kos
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% kosList.forEach(kos => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100 kos-card">
            <div class="position-relative">
              <% if (kos.images && kos.images.length > 0 && kos.images[0] !== '') { %>
                <img src="/uploads/kos/<%= kos.images[0] %>" class="card-img-top" alt="<%= kos.name %>"
                     style="height: 220px; object-fit: cover;">
              <% } else { %>
                <div class="card-img-top d-flex align-items-center justify-content-center"
                     style="height: 220px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                  <i class="bi bi-house-fill display-3 text-white opacity-50"></i>
                </div>
              <% } %>
              <form action="/kos/<%= kos.id %>/favorite" method="POST" class="position-absolute top-0 end-0 m-3">
                <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm">
                  <i class="bi bi-heart-fill text-danger"></i>
                </button>
              </form>
            </div>
            <div class="card-body">
              <h5 class="fw-bold"><%= kos.name %></h5>
              <p class="text-muted small mb-2"><i class="bi bi-geo-alt text-danger me-1"></i><%= kos.address %>, <%= kos.city %></p>
              <div class="d-flex align-items-center mb-2">
                <div class="text-warning me-2">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <i class="bi bi-star<%= i <= Math.round(kos.avg_rating) ? '-fill' : '' %> small"></i>
                  <% } %>
                </div>
                <small class="text-muted"><%= kos.avg_rating %> (<%= kos.total_reviews %>)</small>
              </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
              <span class="fs-5 fw-bold text-primary">Rp <%= Number(kos.price_monthly).toLocaleString('id-ID') %></span>
              <a href="/kos/<%= kos.id %>" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-eye me-1"></i>Detail
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
