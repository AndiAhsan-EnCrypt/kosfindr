<%- include('../partials/header') %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1"><i class="bi bi-search me-2 text-primary"></i>Cari Kos</h2>
      <p class="text-muted mb-0">Ditemukan <strong><%= kosList.length %></strong> kos</p>
    </div>
  </div>

  <!-- Filter Section -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form action="/kos" method="GET">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label class="form-label small fw-semibold">
              <i class="bi bi-search me-1"></i>Pencarian
            </label>
            <input type="text" name="search" class="form-control" placeholder="Nama kos, alamat..." 
                   value="<%= filters.search %>">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">
              <i class="bi bi-geo-alt me-1"></i>Kota
            </label>
            <select name="city" class="form-select">
              <option value="">Semua Kota</option>
              <% cities.forEach(city => { %>
                <option value="<%= city %>" <%= filters.city === city ? 'selected' : '' %>><%= city %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">
              <i class="bi bi-people me-1"></i>Tipe
            </label>
            <select name="type" class="form-select">
              <option value="">Semua Tipe</option>
              <option value="putra" <%= filters.type === 'putra' ? 'selected' : '' %>>Putra</option>
              <option value="putri" <%= filters.type === 'putri' ? 'selected' : '' %>>Putri</option>
              <option value="campur" <%= filters.type === 'campur' ? 'selected' : '' %>>Campur</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Harga Min</label>
            <input type="number" name="price_min" class="form-control" placeholder="Rp min" 
                   value="<%= filters.price_min %>">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-semibold">Harga Max</label>
            <input type="number" name="price_max" class="form-control" placeholder="Rp max" 
                   value="<%= filters.price_max %>">
          </div>
          <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-funnel"></i>
            </button>
          </div>
        </div>

        <!-- Sort -->
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
          <div class="d-flex gap-2">
            <a href="/kos" class="btn btn-sm btn-outline-secondary rounded-pill">
              <i class="bi bi-x me-1"></i>Reset
            </a>
          </div>
          <div class="d-flex align-items-center gap-2">
            <small class="text-muted">Urutkan:</small>
            <select name="sort" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
              <option value="latest" <%= filters.sort === 'latest' ? 'selected' : '' %>>Terbaru</option>
              <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Harga Terendah</option>
              <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Harga Tertinggi</option>
              <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Rating Tertinggi</option>
            </select>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Kos List -->
  <div class="row g-4">
    <% if (kosList.length === 0) { %>
      <div class="col-12 text-center py-5">
        <i class="bi bi-house-slash display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">Tidak ada kos ditemukan</h4>
        <p class="text-muted">Coba ubah filter pencarian kamu</p>
        <a href="/kos" class="btn btn-primary rounded-pill">
          <i class="bi bi-arrow-clockwise me-1"></i>Reset Filter
        </a>
      </div>
    <% } else { %>
      <% kosList.forEach(kos => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100 kos-card">
            <div class="position-relative">
              <% if (kos.images && kos.images.length > 0 && kos.images[0] !== '') { %>
                <img src="/uploads/kos/<%= kos.images[0] %>" class="card-img-top" alt="<%= kos.name %>"
                     style="height: 220px; object-fit: cover;">
              <% } else { %>
                <div class="card-img-top d-flex align-items-center justify-content-center"
                     style="height: 220px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                  <i class="bi bi-house-fill display-3 text-white opacity-50"></i>
                </div>
              <% } %>
              <span class="badge bg-<%= kos.type === 'putra' ? 'primary' : kos.type === 'putri' ? 'danger' : 'success' %> position-absolute top-0 end-0 m-3 rounded-pill">
                <%= kos.type.charAt(0).toUpperCase() + kos.type.slice(1) %>
              </span>

              <% if (user) { %>
                <form action="/kos/<%= kos.id %>/favorite" method="POST" class="position-absolute top-0 start-0 m-3">
                  <button type="submit" class="btn btn-sm btn-light rounded-circle shadow-sm" title="Favorit">
                    <i class="bi bi-heart<%= userFavorites.includes(kos.id) ? '-fill text-danger' : '' %>"></i>
                  </button>
                </form>
              <% } %>

              <% if (kos.rooms_available > 0) { %>
                <span class="badge bg-success position-absolute bottom-0 start-0 m-3 rounded-pill">
                  <i class="bi bi-door-open me-1"></i><%= kos.rooms_available %> kamar tersedia
                </span>
              <% } else { %>
                <span class="badge bg-danger position-absolute bottom-0 start-0 m-3 rounded-pill">
                  <i class="bi bi-door-closed me-1"></i>Penuh
                </span>
              <% } %>
            </div>

            <div class="card-body">
              <h5 class="card-title fw-bold mb-1"><%= kos.name %></h5>
              <p class="text-muted small mb-2">
                <i class="bi bi-geo-alt text-danger me-1"></i><%= kos.address %>, <%= kos.city %>
              </p>

              <div class="d-flex align-items-center mb-2">
                <div class="text-warning me-2">
                  <% for(let i = 1; i <= 5; i++) { %>
                    <i class="bi bi-star<%= i <= Math.round(kos.avg_rating) ? '-fill' : '' %> small"></i>
                  <% } %>
                </div>
                <small class="text-muted"><%= kos.avg_rating %> (<%= kos.total_reviews %>)</small>
              </div>

              <div class="d-flex flex-wrap gap-1 mb-2">
                <% if (kos.facilities && kos.facilities.length > 0) { %>
                  <% kos.facilities.slice(0, 3).forEach(f => { %>
                    <span class="badge bg-light text-dark border small"><%= f %></span>
                  <% }) %>
                  <% if (kos.facilities.length > 3) { %>
                    <span class="badge bg-light text-muted border small">+<%= kos.facilities.length - 3 %></span>
                  <% } %>
                <% } %>
              </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
              <div>
                <span class="fs-5 fw-bold text-primary">Rp <%= Number(kos.price_monthly).toLocaleString('id-ID') %></span>
                <small class="text-muted">/ bln</small>
              </div>
              <a href="/kos/<%= kos.id %>" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="bi bi-eye me-1"></i>Detail
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (pagination.totalPages > 1) { %>
    <nav class="mt-5 d-flex justify-content-center" aria-label="Pagination">
      <ul class="pagination">
        <% const qs = (p) => { const params = new URLSearchParams(); if (filters.search) params.set('search', filters.search); if (filters.city) params.set('city', filters.city); if (filters.type) params.set('type', filters.type); if (filters.price_min) params.set('price_min', filters.price_min); if (filters.price_max) params.set('price_max', filters.price_max); if (filters.sort) params.set('sort', filters.sort); params.set('page', p); return '?' + params.toString(); }; %>
        <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/kos<%= qs(pagination.page - 1) %>">«</a>
        </li>
        <% for (let i = 1; i <= pagination.totalPages; i++) { %>
          <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="/kos<%= qs(i) %>"><%= i %></a>
          </li>
        <% } %>
        <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/kos<%= qs(pagination.page + 1) %>">»</a>
        </li>
      </ul>
    </nav>
    <p class="text-center text-muted small mt-2">
      Menampilkan <%= kosList.length %> dari <%= pagination.total %> kos
    </p>
  <% } %>
</div>

<%- include('../partials/footer') %>
