<%- include('../partials/header') %>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold"><i class="bi bi-building me-2 text-primary"></i>Kos Saya</h2>
      <p class="text-muted mb-0"><%= kosList.length %> kos terdaftar</p>
    </div>
    <a href="/kos/create" class="btn btn-primary rounded-pill">
      <i class="bi bi-plus-circle me-1"></i>Tambah Kos
    </a>
  </div>

  <% if (kosList.length === 0) { %>
    <div class="text-center py-5">
      <i class="bi bi-house-add display-1 text-muted"></i>
      <h4 class="mt-3 text-muted">Belum ada kos terdaftar</h4>
      <p class="text-muted">Mulai daftarkan kos Anda sekarang!</p>
      <a href="/kos/create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-circle me-1"></i>Tambah Kos Pertama
      </a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% kosList.forEach(kos => { %>
        <div class="col-md-6 col-lg-4">
          <div class="card border-0 shadow-sm h-100">
            <div class="position-relative">
              <% if (kos.images && kos.images.length > 0 && kos.images[0] !== '') { %>
                <img src="/uploads/kos/<%= kos.images[0] %>" class="card-img-top" alt="<%= kos.name %>"
                     style="height: 200px; object-fit: cover;">
              <% } else { %>
                <div class="card-img-top d-flex align-items-center justify-content-center"
                     style="height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                  <i class="bi bi-house-fill display-4 text-white opacity-50"></i>
                </div>
              <% } %>
              <span class="badge bg-<%= kos.status === 'active' ? 'success' : kos.status === 'pending' ? 'warning' : 'secondary' %> position-absolute top-0 end-0 m-2 rounded-pill">
                <%= kos.status === 'active' ? 'Aktif' : kos.status === 'pending' ? 'Pending' : 'Nonaktif' %>
              </span>
            </div>
            <div class="card-body">
              <h5 class="fw-bold"><%= kos.name %></h5>
              <p class="text-muted small mb-1">
                <i class="bi bi-geo-alt text-danger me-1"></i><%= kos.address %>, <%= kos.city %>
              </p>
              <p class="text-primary fw-bold mb-2">Rp <%= Number(kos.price_monthly).toLocaleString('id-ID') %> / bulan</p>
              <div class="d-flex align-items-center small text-muted">
                <span class="me-3"><i class="bi bi-star-fill text-warning me-1"></i><%= kos.avg_rating %></span>
                <span class="me-3"><i class="bi bi-chat me-1"></i><%= kos.total_reviews %> review</span>
                <span><i class="bi bi-door-open me-1"></i><%= kos.rooms_available %> kamar</span>
              </div>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
              <a href="/kos/<%= kos.id %>" class="btn btn-outline-primary btn-sm flex-fill rounded-pill">
                <i class="bi bi-eye me-1"></i>Lihat
              </a>
              <a href="/kos/<%= kos.id %>/edit" class="btn btn-outline-warning btn-sm flex-fill rounded-pill">
                <i class="bi bi-pencil me-1"></i>Edit
              </a>
              <form action="/kos/<%= kos.id %>?_method=DELETE" method="POST" class="flex-fill"
                    onsubmit="return confirm('Yakin ingin menghapus kos ini?')">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
                  <i class="bi bi-trash me-1"></i>Hapus
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
