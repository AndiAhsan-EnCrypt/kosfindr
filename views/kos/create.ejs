<%- include('../partials/header') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card border-0 shadow-lg">
        <div class="card-body p-5">
          <h3 class="fw-bold mb-4"><i class="bi bi-plus-circle me-2 text-primary"></i>Tambah Kos Baru</h3>

          <form action="/kos/create" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-12">
                <label for="name" class="form-label fw-semibold">Nama Kos *</label>
                <input type="text" class="form-control form-control-lg" id="name" name="name"
                       placeholder="Contoh: Kos Putra Sejahtera" required>
              </div>

              <div class="col-md-6">
                <label for="city" class="form-label fw-semibold">Kota *</label>
                <input type="text" class="form-control" id="city" name="city"
                       placeholder="Contoh: Yogyakarta" required>
              </div>

              <div class="col-md-6">
                <label for="address" class="form-label fw-semibold">Alamat Lengkap *</label>
                <input type="text" class="form-control" id="address" name="address"
                       placeholder="Jl. Contoh No. 123" required>
              </div>

              <div class="col-md-4">
                <label for="price_monthly" class="form-label fw-semibold">Harga / Bulan (Rp) *</label>
                <input type="number" class="form-control" id="price_monthly" name="price_monthly"
                       placeholder="850000" required min="0">
              </div>

              <div class="col-md-4">
                <label for="type" class="form-label fw-semibold">Tipe Kos *</label>
                <select class="form-select" id="type" name="type" required>
                  <option value="putra">Putra</option>
                  <option value="putri">Putri</option>
                  <option value="campur" selected>Campur</option>
                </select>
              </div>

              <div class="col-md-4">
                <label for="rooms_available" class="form-label fw-semibold">Kamar Tersedia</label>
                <input type="number" class="form-control" id="rooms_available" name="rooms_available"
                       placeholder="5" min="0" value="1">
              </div>

              <div class="col-12">
                <label for="description" class="form-label fw-semibold">Deskripsi</label>
                <textarea class="form-control" id="description" name="description" rows="4"
                          placeholder="Deskripsikan kos Anda secara detail..."></textarea>
              </div>

              <div class="col-12">
                <label class="form-label fw-semibold">Fasilitas</label>
                <div class="row g-2">
                  <% const facilityOptions = ['WiFi', 'AC', 'Kamar Mandi Dalam', 'Kamar Mandi Luar', 'Parkir Motor', 'Parkir Mobil', 'Dapur Bersama', 'Laundry', 'TV', 'Kulkas', 'CCTV', 'Cleaning Service', 'Ruang Tamu', 'Listrik Token']; %>
                  <% facilityOptions.forEach(f => { %>
                    <div class="col-6 col-md-3">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="facilities" value="<%= f %>" id="fac-<%= f.replace(/\s/g, '') %>">
                        <label class="form-check-label small" for="fac-<%= f.replace(/\s/g, '') %>"><%= f %></label>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>

              <div class="col-12">
                <label for="rules" class="form-label fw-semibold">Peraturan Kos</label>
                <textarea class="form-control" id="rules" name="rules" rows="3"
                          placeholder="Tuliskan peraturan kos..."></textarea>
              </div>

              <div class="col-12">
                <label for="images" class="form-label fw-semibold">
                  <i class="bi bi-camera me-1"></i>Foto Kos (maks. 5 foto, masing-masing maks. 5MB)
                </label>
                <input type="file" class="form-control" id="images" name="images" accept="image/*" multiple>
                <div id="imagePreview" class="d-flex flex-wrap gap-2 mt-2"></div>
              </div>

              <div class="col-12">
                <hr>
                <div class="d-flex justify-content-between">
                  <a href="/kos/my-listings" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i>Batal
                  </a>
                  <button type="submit" class="btn btn-primary rounded-pill px-5">
                    <i class="bi bi-check-circle me-1"></i>Simpan Kos
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
