<%- include('../partials/header') %>

<div class="container-fluid py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="bi bi-speedometer2 me-2 text-warning"></i>Admin Dashboard</h2>
    <a href="/" class="btn btn-outline-secondary rounded-pill btn-sm">
      <i class="bi bi-house me-1"></i>Ke Beranda
    </a>
  </div>

  <!-- Stats Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-primary text-white">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h4 class="fw-bold mb-0"><%= stats.totalKos %></h4>
            <small>Total Kos</small>
          </div>
          <i class="bi bi-building fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-success text-white">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h4 class="fw-bold mb-0"><%= stats.totalUsers %></h4>
            <small>Total User</small>
          </div>
          <i class="bi bi-people fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-warning text-dark">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div>
            <h4 class="fw-bold mb-0"><%= stats.totalReviews %></h4>
            <small>Total Review</small>
          </div>
          <i class="bi bi-chat-quote fs-1 opacity-50"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs -->
  <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active fw-semibold" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button">
        <i class="bi bi-people me-1"></i>Users (<%= users.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-semibold" id="kos-tab" data-bs-toggle="tab" data-bs-target="#kosList" type="button">
        <i class="bi bi-building me-1"></i>Kos (<%= kosList.length %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link fw-semibold" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviewsList" type="button">
        <i class="bi bi-chat-quote me-1"></i>Reviews (<%= reviews.length %>)
      </button>
    </li>
  </ul>

  <div class="tab-content" id="adminTabContent">
    <!-- Users Tab -->
    <div class="tab-pane fade show active" id="users" role="tabpanel">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Nama</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Role</th>
                <th>Tgl Daftar</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(u => { %>
                <tr>
                  <td><%= u.id %></td>
                  <td class="fw-semibold"><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td><%= u.phone || '-' %></td>
                  <td>
                    <span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'pemilik' ? 'warning text-dark' : 'primary' %> rounded-pill">
                      <%= u.role %>
                    </span>
                  </td>
                  <td><%= new Date(u.created_at).toLocaleDateString('id-ID') %></td>
                  <td>
                    <% if (u.role !== 'admin') { %>
                      <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" class="d-inline"
                            onsubmit="return confirm('Yakin hapus user ini?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                          <i class="bi bi-trash"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Kos Tab -->
    <div class="tab-pane fade" id="kosList" role="tabpanel">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Nama</th>
                <th>Pemilik</th>
                <th>Kota</th>
                <th>Harga</th>
                <th>Tipe</th>
                <th>Rating</th>
                <th>Status</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% kosList.forEach(k => { %>
                <tr>
                  <td><%= k.id %></td>
                  <td class="fw-semibold"><%= k.name %></td>
                  <td><%= k.owner_name %></td>
                  <td><%= k.city %></td>
                  <td>Rp <%= Number(k.price_monthly).toLocaleString('id-ID') %></td>
                  <td><span class="badge bg-<%= k.type === 'putra' ? 'primary' : k.type === 'putri' ? 'danger' : 'success' %> rounded-pill"><%= k.type %></span></td>
                  <td><i class="bi bi-star-fill text-warning"></i> <%= k.avg_rating %></td>
                  <td>
                    <form action="/admin/kos/<%= k.id %>/status?_method=PUT" method="POST" class="d-inline">
                      <select name="status" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                        <option value="active" <%= k.status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="inactive" <%= k.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        <option value="pending" <%= k.status === 'pending' ? 'selected' : '' %>>Pending</option>
                      </select>
                    </form>
                  </td>
                  <td>
                    <div class="d-flex gap-1">
                      <a href="/kos/<%= k.id %>" class="btn btn-sm btn-outline-primary rounded-pill"><i class="bi bi-eye"></i></a>
                      <form action="/admin/kos/<%= k.id %>?_method=DELETE" method="POST" class="d-inline"
                            onsubmit="return confirm('Yakin hapus kos ini?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Reviews Tab -->
    <div class="tab-pane fade" id="reviewsList" role="tabpanel">
      <div class="card border-0 shadow-sm">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>User</th>
                <th>Kos</th>
                <th>Rating</th>
                <th>Komentar</th>
                <th>Tanggal</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% reviews.forEach(r => { %>
                <tr>
                  <td><%= r.id %></td>
                  <td class="fw-semibold"><%= r.user_name %></td>
                  <td><%= r.kos_name %></td>
                  <td>
                    <div class="text-warning">
                      <% for(let i = 1; i <= 5; i++) { %>
                        <i class="bi bi-star<%= i <= r.rating ? '-fill' : '' %> small"></i>
                      <% } %>
                    </div>
                  </td>
                  <td><%= r.comment ? r.comment.substring(0, 50) + (r.comment.length > 50 ? '...' : '') : '-' %></td>
                  <td><%= new Date(r.created_at).toLocaleDateString('id-ID') %></td>
                  <td>
                    <form action="/admin/reviews/<%= r.id %>?_method=DELETE" method="POST" class="d-inline"
                          onsubmit="return confirm('Yakin hapus review ini?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
